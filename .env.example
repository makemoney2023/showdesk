# Copy to `.env.local` (never commit real keys)

# Demo mode if either public Supabase var is missing
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Speech-to-text (preferred)
DEEPGRAM_API_KEY=

# Optional legacy STT / LeMUR draft assist
ASSEMBLYAI_API_KEY=

# Optional email on approve
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Public site URL (canonical, sitemap, share links). Use the custom domain,
# not a *.vercel.app host (team hosts ask for a Vercel login).
NEXT_PUBLIC_SITE_URL=https://www.showdesk-app.com

# Facebook Page auto-post (Graph API). Groups cannot be posted via API.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
NEXT_PUBLIC_FACEBOOK_GROUP_URL=
